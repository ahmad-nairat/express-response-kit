{
  "name": "express-response-kit",
  "version": "1.0.0",
  "description": "Opinionated response helpers that extend Express.js response with clean, reusable, and type-safe methods.",
  "author": "ahmad-nairat",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "release": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "express",
    "express-response",
    "response-kit",
    "nodejs",
    "nodejs-response"
  ],
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "express": ">=4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "codecov": "^3.8.2",
    "express": "^4.22.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmad-nairat/express-response-kit.git"
  },
  "bugs": {
    "url": "https://github.com/ahmad-nairat/express-response-kit/issues"
  },
  "homepage": "https://github.com/ahmad-nairat/express-response-kit#readme"
}
